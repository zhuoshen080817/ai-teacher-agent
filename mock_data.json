      "html_code": "<div style='background:#0f1114;color:#e4e4e7;font-family:Cascadia Code,monospace;display:grid;grid-template-columns:1.2fr 1fr;gap:28px;padding:36px;min-height:420px;font-size:19px;'><div><div class='reveal-p3' style='opacity:0;margin-bottom:6px;'><span style='color:#f3c969;'>void</span> swap(<span style='color:#f3c969;'>int</span> *a, <span style='color:#f3c969;'>int</span> *b){</div><div class='reveal-p3' style='opacity:0;margin-left:24px;margin-bottom:6px;'><span style='color:#f3c969;'>if</span>(!a || !b) <span style='color:#f3c969;'>return</span>;</div><div class='reveal-p3' style='opacity:0;margin-left:24px;margin-bottom:6px;'>int t = *a;</div><div class='reveal-p3' style='opacity:0;margin-left:24px;margin-bottom:6px;'>*a = *b;</div><div class='reveal-p3' style='opacity:0;margin-left:24px;margin-bottom:6px;'>*b = t;</div><div class='reveal-p3' style='opacity:0;'>}</div></div><div><div class='reveal-p3' style='opacity:0;border-left:4px solid #f3c969;padding-left:14px;margin-bottom:18px;'>传地址，改本尊</div><div class='reveal-p3' style='opacity:0;border-left:4px solid #f3c969;padding-left:14px;margin-bottom:18px;'>先判空，防野指针</div><div class='reveal-p3' style='opacity:0;border-left:4px solid #f3c969;padding-left:14px;'>解引用才是那块内存</div></div><style>.reveal-p3.is-active{opacity:1 !important;animation:fp3 .5s forwards;}@keyframes fp3{from{opacity:0;transform:translateX(12px);}to{opacity:1;transform:none;}}</style></div>",
