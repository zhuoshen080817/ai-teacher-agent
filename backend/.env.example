# 大模型提供方：gemini（默认）或 deepseek，支持一键切换
LLM_PROVIDER=gemini

# Google Gemini API Key 与默认模型
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-4-hydrogen

# DeepSeek API Key（用于生成知识框架及 Gemini 失败时自动降级）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼 DashScope API Key（用于 ASR、CosyVoice 与视觉兜底模型）
DASHSCOPE_API_KEY=your_dashscope_api_key

# 视觉模型提供方：默认使用 GEMINI_MODEL（gemini-4-hydrogen）处理图片，失败自动降级阿里云 qwen-vl
# VISION_PROVIDER=gemini
# 可选：阿里云视觉兜底模型，默认 qwen3-vl-plus
# VISION_MODEL=qwen-vl-plus

# 大模型重试与自动降级设置
LLM_FALLBACK_ENABLED=true
LLM_MAX_RETRIES=3
LLM_TIMEOUT=90
LLM_STORYBOARD_TIMEOUT=240

# 长音频全局 ASR 并发分片池配置
ASR_MAX_WORKERS=8
ASR_CHUNK_MAX_RETRIES=2
